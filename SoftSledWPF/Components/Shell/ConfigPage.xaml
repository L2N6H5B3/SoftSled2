<UserControl x:Class="SoftSledWPF.Components.Shell.ConfigPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="Transparent"
             d:DesignHeight="720" d:DesignWidth="1280">
    <Viewbox Stretch="Uniform">
        <Grid Width="1280" Height="720">

            <!-- Title strip — shared across all sub-views, content set
                 from code-behind when sub-view changes. -->
            <TextBlock x:Name="HeaderText"
                       Style="{StaticResource WmcTitleStyle}"
                       Text="settings"
                       Margin="100,60,0,0"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"/>

            <TextBlock x:Name="BreadcrumbText"
                       Style="{StaticResource WmcSubtitleStyle}"
                       Foreground="{StaticResource WmcSubtleTextBrush}"
                       Margin="100,135,0,0"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"/>

            <!-- ===== Root menu ============================================ -->
            <Grid x:Name="RootView"
                  Margin="100,200,100,80"
                  Visibility="Visible">
                <ListBox x:Name="RootMenu"
                         Style="{StaticResource WmcListBoxStyle}"
                         ItemContainerStyle="{StaticResource WmcListItemStyle}"
                         Width="520"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Top"
                         KeyDown="RootMenu_KeyDown"
                         MouseLeftButtonUp="RootMenu_MouseLeftButtonUp">
                    <ListBoxItem x:Name="ItemSetup"     Content="First-Time Setup" IsSelected="True"/>
                    <ListBoxItem x:Name="ItemGeneral"   Content="General"/>
                    <ListBoxItem x:Name="ItemPairing"   Content="Pairing"/>
                    <ListBoxItem x:Name="ItemVideo"     Content="Video"/>
                    <ListBoxItem x:Name="ItemAudio"     Content="Audio"/>
                    <ListBoxItem x:Name="ItemUi"        Content="UI"/>
                    <ListBoxItem x:Name="ItemRemote"    Content="Remote"/>
                    <ListBoxItem x:Name="ItemDebugging" Content="Debugging"/>
                    <ListBoxItem x:Name="ItemAbout"     Content="About"/>
                </ListBox>
            </Grid>

            <!-- ===== General sub-view ===================================== -->
            <Grid x:Name="GeneralView"
                  Margin="100,200,100,80"
                  Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Left" Width="640">
                    
                    <CheckBox x:Name="ChkFullScreen"
                              Style="{StaticResource WmcCheckBoxStyle}"
                              Content="Run full screen"
                              Click="OnConfigChanged"/>
                    <TextBlock Style="{StaticResource WmcBodyStyle}"
                              Foreground="{StaticResource WmcSubtleTextBrush}"
                              Margin="10,16,0,0"
                              Text="Tip: press F11 at any time to toggle full screen without changing this setting."/>
                    <CheckBox x:Name="ChkLockAspect"
                              Style="{StaticResource WmcCheckBoxStyle}"
                              Content="Lock window shape to selected resolution"
                              Margin="0,16,0,0"
                              Click="OnConfigChanged"/>
                    <TextBlock Style="{StaticResource WmcBodyStyle}"
                               Foreground="{StaticResource WmcSubtleTextBrush}"
                               Margin="10,4,0,0"
                               TextWrapping="Wrap"
                               Text="Constrains window resizing to the aspect ratio of the resolution chosen in Video settings, removing the black bars on the edges. Has no effect in full screen."/>
                    <CheckBox x:Name="ChkAutoStart"
                              Style="{StaticResource WmcCheckBoxStyle}"
                              Content="Auto-start the extender session on launch"
                              Click="OnConfigChanged"/>
                    <CheckBox x:Name="ChkCloseOnWmcClose"
                              Style="{StaticResource WmcCheckBoxStyle}"
                              Content="Close SoftSled when Windows Media Center closes"
                              Click="OnConfigChanged"/>
                    <CheckBox x:Name="ChkKeepScreenAwake"
                              Style="{StaticResource WmcCheckBoxStyle}"
                              Content="Keep the screen awake while running"
                              Click="OnConfigChanged"/>
                    <TextBlock Style="{StaticResource WmcBodyStyle}"
                               Foreground="{StaticResource WmcSubtleTextBrush}"
                               Margin="10,4,0,0"
                               TextWrapping="Wrap"
                               Text="Prevents the Windows screen-saver and display/sleep timers from blanking the screen during playback or while idling on a menu."/>
                    
                </StackPanel>
            </Grid>

            <!-- ===== Pairing sub-view ===================================== -->
            <Grid x:Name="PairingView"
                  Margin="100,200,100,80"
                  Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Left" Width="640">
                    <TextBlock x:Name="PairingStatusText"
                               Style="{StaticResource WmcBodyStyle}"
                               Margin="10,0,0,30"/>
                    <Button x:Name="UnpairButton"
                            Style="{StaticResource WmcButtonStyle}"
                            Content="Unpair extender"
                            HorizontalAlignment="Left"
                            MinWidth="240"
                            Click="UnpairButton_Click"/>
                    <TextBlock Style="{StaticResource WmcBodyStyle}"
                               Foreground="{StaticResource WmcSubtleTextBrush}"
                               Margin="10,30,0,0"
                               TextWrapping="Wrap"
                               Text="Unpairing clears the stored host credentials. You will need to run the Add Extender wizard in Windows Media Center again before you can connect."/>
                </StackPanel>
            </Grid>

            <!-- ===== Video sub-view ======================================= -->
            <Grid x:Name="VideoView"
                  Margin="100,200,100,80"
                  Visibility="Collapsed">
                <!-- Content can overflow the ~440px sub-view height
                     once enough toggles are added; wrap in a
                     ScrollViewer so lower controls stay reachable.
                     Focusable=False keeps the WMC-remote tab-stop
                     traversal walking through the child checkboxes,
                     and each focused control auto-scrolls into view
                     via WPF's default BringIntoView behaviour. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly"
                              Focusable="False">
                <StackPanel HorizontalAlignment="Left" Width="640">
                    <CheckBox x:Name="ChkHdContent"
                              Style="{StaticResource WmcCheckBoxStyle}"
                              Content="Enable HD Content"
                              Click="OnConfigChanged"/>
                    <CheckBox x:Name="ChkRemoteRendering"
                              Style="{StaticResource WmcCheckBoxStyle}"
                              Content="Enable Remote Rendering"
                              Click="OnConfigChanged"/>
                    <CheckBox x:Name="Chk2DAnimations"
                              Style="{StaticResource WmcCheckBoxStyle}"
                              Content="Enable 2D animations"
                              Click="OnConfigChanged"/>
                    <CheckBox x:Name="ChkIntenseAnimations"
                              Style="{StaticResource WmcCheckBoxStyle}"
                              Content="Enable Intense animations"
                              Click="OnConfigChanged"/>
                    <CheckBox x:Name="ChkOverscan"
                              Style="{StaticResource WmcCheckBoxStyle}"
                              Content="Enable Overscan Margin"
                              Click="OnConfigChanged"/>

                    <!-- Resolution picker. The button shows the current
                         selection; clicking opens the ResolutionOverlay
                         below for picking a new one. Lives in its own
                         labelled row so it visually groups with the
                         tickboxes without trying to be one. -->
                    <TextBlock Style="{StaticResource WmcSubtitleStyle}"
                               Text="Resolution"
                               Foreground="{StaticResource WmcTextBrush}"
                               Margin="10,30,0,8"/>
                    <Button x:Name="BtnResolution"
                            Style="{StaticResource WmcButtonStyle}"
                            HorizontalAlignment="Left"
                            MinWidth="320"
                            Margin="10,0,0,0"
                            Content="—"
                            Click="BtnResolution_Click"/>
                </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ===== Audio sub-view ======================================= -->
            <Grid x:Name="AudioView"
                  Margin="100,200,100,80"
                  Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Left" Width="640">
                    <TextBlock Style="{StaticResource WmcSubtitleStyle}"
                               Text="Audio sync offset"
                               Foreground="{StaticResource WmcTextBrush}"
                               Margin="10,0,0,8"/>
                    <TextBlock Style="{StaticResource WmcBodyStyle}"
                               Foreground="{StaticResource WmcSubtleTextBrush}"
                               Margin="10,0,0,16"
                               TextWrapping="Wrap"
                               Text="Adjust if audio appears out of sync with video — e.g. when an HDMI display adds picture-processing lag or an A/V receiver delays audio. Positive values delay audio (use when video lags); negative values delay video (use when audio lags). Applied automatically when the external-sync audio engine is enabled."/>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Left"
                                Margin="10,0,0,0">
                        <Button x:Name="BtnAudioSyncMinusBig"
                                Style="{StaticResource WmcButtonStyle}"
                                Content="-50ms"
                                MinWidth="100"
                                Click="BtnAudioSyncMinusBig_Click"/>
                        <Button x:Name="BtnAudioSyncMinus"
                                Style="{StaticResource WmcButtonStyle}"
                                Content="-10ms"
                                MinWidth="100"
                                Click="BtnAudioSyncMinus_Click"/>
                        <TextBlock x:Name="AudioSyncValueText"
                                   Style="{StaticResource WmcSubtitleStyle}"
                                   Foreground="{StaticResource WmcTextBrush}"
                                   VerticalAlignment="Center"
                                   Width="160"
                                   TextAlignment="Center"
                                   Text="0 ms"/>
                        <Button x:Name="BtnAudioSyncPlus"
                                Style="{StaticResource WmcButtonStyle}"
                                Content="+10ms"
                                MinWidth="100"
                                Click="BtnAudioSyncPlus_Click"/>
                        <Button x:Name="BtnAudioSyncPlusBig"
                                Style="{StaticResource WmcButtonStyle}"
                                Content="+50ms"
                                MinWidth="100"
                                Click="BtnAudioSyncPlusBig_Click"/>
                    </StackPanel>
                    <Button x:Name="BtnAudioSyncReset"
                            Style="{StaticResource WmcButtonStyle}"
                            Content="Reset to 0 ms"
                            HorizontalAlignment="Left"
                            MinWidth="240"
                            Margin="10,16,0,0"
                            Click="BtnAudioSyncReset_Click"/>
                </StackPanel>
            </Grid>

            <!-- ===== UI sub-view ========================================== -->
            <Grid x:Name="UiView"
                  Margin="100,200,100,80"
                  Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Left" Width="640">
                    <CheckBox x:Name="ChkUiSounds"
                              Style="{StaticResource WmcCheckBoxStyle}"
                              Content="Enable UI Sounds"
                              Click="OnConfigChanged"/>
                    <CheckBox x:Name="ChkPopups"
                              Style="{StaticResource WmcCheckBoxStyle}"
                              Content="Enable Pop-ups"
                              Click="OnConfigChanged"/>
                    <CheckBox x:Name="ChkToolbar"
                              Style="{StaticResource WmcCheckBoxStyle}"
                              Content="Enable Toolbar"
                              Click="OnConfigChanged"/>
                    <CheckBox x:Name="ChkMouseInput"
                              Style="{StaticResource WmcCheckBoxStyle}"
                              Content="Enable mouse input"
                              Click="OnConfigChanged"/>
                </StackPanel>
            </Grid>

            <!-- ===== Remote sub-view ===================================== -->
            <Grid x:Name="RemoteView"
                  Margin="100,190,100,80"
                  Visibility="Collapsed">
                <Grid Width="1040" HorizontalAlignment="Left">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Style="{StaticResource WmcBodyStyle}"
                               Foreground="{StaticResource WmcSubtleTextBrush}"
                               Margin="10,0,0,12"
                               TextWrapping="Wrap"
                               Text="Choose a command and press Learn, then press the button on your remote you want to use for it. Navigation, OK and number buttons are handled directly and aren't listed here."/>

                    <!-- Command rows are generated in code from the remote
                         command catalogue and dropped into RemoteList. -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  PanningMode="VerticalOnly"
                                  Focusable="False">
                        <StackPanel x:Name="RemoteList" HorizontalAlignment="Stretch"/>
                    </ScrollViewer>

                    <Button Grid.Row="2"
                            x:Name="BtnRemoteReset"
                            Style="{StaticResource WmcButtonStyle}"
                            Content="Reset all to defaults"
                            HorizontalAlignment="Left"
                            MinWidth="280"
                            Margin="10,16,0,0"
                            Click="BtnRemoteReset_Click"/>
                </Grid>
            </Grid>

            <!-- ===== Debugging sub-view =================================== -->
            <Grid x:Name="DebuggingView"
                  Margin="100,200,100,80"
                  Visibility="Collapsed">
                <!-- Wrap in ScrollViewer so the growing list of toggles
                     stays reachable. Matches the Video sub-view pattern. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly"
                              Focusable="False">
                <StackPanel HorizontalAlignment="Left" Width="640">
                    <CheckBox x:Name="ChkLogger"
                              Style="{StaticResource WmcCheckBoxStyle}"
                              Content="Show on-screen log overlay"
                              Click="OnConfigChanged"/>
                    <TextBlock Style="{StaticResource WmcBodyStyle}"
                               Foreground="{StaticResource WmcSubtleTextBrush}"
                               Margin="10,16,0,24"
                               TextWrapping="Wrap"
                               Text="The log overlay appears on the right edge of the session view. You can also toggle it during a session with Ctrl+L."/>

                    <CheckBox x:Name="ChkLogDevCaps"
                              Style="{StaticResource WmcCheckBoxStyle}"
                              Content="Include DevCaps VirtualChannel logs"
                              Click="OnConfigChanged"/>
                    <CheckBox x:Name="ChkLogMcxSess"
                              Style="{StaticResource WmcCheckBoxStyle}"
                              Content="Include McxSess VirtualChannel logs"
                              Click="OnConfigChanged"/>
                    <CheckBox x:Name="ChkLogAvCtrl"
                              Style="{StaticResource WmcCheckBoxStyle}"
                              Content="Include AvCtrl VirtualChannel logs"
                              Click="OnConfigChanged"/>
                    <CheckBox x:Name="ChkLogRdpFastpath"
                              Style="{StaticResource WmcCheckBoxStyle}"
                              Content="Include RDP Fastpath logs"
                              Click="OnConfigChanged"/>
                    <CheckBox x:Name="ChkLogAvPlayback"
                              Style="{StaticResource WmcCheckBoxStyle}"
                              Content="Include A/V (libav / sync) logs"
                              Click="OnConfigChanged"/>

                    <!-- File logging — survives a crash so release-build
                         hangs on remote machines can still be diagnosed. -->
                    <CheckBox x:Name="ChkLogToFile"
                              Style="{StaticResource WmcCheckBoxStyle}"
                              Content="Write logs to file"
                              Margin="0,16,0,0"
                              Click="OnConfigChanged"/>
                    <TextBlock Style="{StaticResource WmcBodyStyle}"
                               Foreground="{StaticResource WmcSubtleTextBrush}"
                               Margin="10,4,0,8"
                               TextWrapping="Wrap"
                               Text="A timestamped log file is created per session in the folder shown below. Auto-flushed so a crash still leaves a captured log on disk."/>
                    <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                        <TextBlock x:Name="LogFolderPath"
                                   Style="{StaticResource WmcBodyStyle}"
                                   Foreground="{StaticResource WmcSubtleTextBrush}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="360"
                                   Text="(folder)"/>
                        <Button x:Name="BtnOpenLogFolder"
                                Content="Open"
                                Margin="12,0,0,0"
                                Padding="14,4"
                                Click="OnOpenLogFolderClick"/>
                        <Button x:Name="BtnChangeLogFolder"
                                Content="Change..."
                                Margin="6,0,0,0"
                                Padding="14,4"
                                Click="OnChangeLogFolderClick"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource WmcBodyStyle}"
                               Foreground="{StaticResource WmcSubtleTextBrush}"
                               Margin="10,4,0,0"
                               FontSize="12"
                               Text="Log path changes take effect on the NEXT app launch."/>

                    <!-- Video jitter buffer (libav + D3DImage player). -->
                    <TextBlock Style="{StaticResource WmcSubtitleStyle}"
                               Text="Video jitter buffer"
                               Foreground="{StaticResource WmcTextBrush}"
                               Margin="0,32,0,4"/>
                    <TextBlock Style="{StaticResource WmcBodyStyle}"
                               Foreground="{StaticResource WmcSubtleTextBrush}"
                               Margin="0,0,0,16"
                               TextWrapping="Wrap"
                               Text="How much video the player buffers to absorb bursty RTSP delivery (frames arrive in ~160 ms bursts around I-frames). Larger values smooth out judder at the cost of more start-up latency. Default 250 ms. Takes effect on the next playback."/>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Left"
                                Margin="10,0,0,0">
                        <Button x:Name="BtnJitterMinus"
                                Style="{StaticResource WmcButtonStyle}"
                                Content="-250ms"
                                MinWidth="100"
                                Click="BtnJitterMinus_Click"/>
                        <TextBlock x:Name="JitterBufferValueText"
                                   Style="{StaticResource WmcSubtitleStyle}"
                                   Foreground="{StaticResource WmcTextBrush}"
                                   VerticalAlignment="Center"
                                   Width="160"
                                   TextAlignment="Center"
                                   Text="250 ms"/>
                        <Button x:Name="BtnJitterPlus"
                                Style="{StaticResource WmcButtonStyle}"
                                Content="+250ms"
                                MinWidth="100"
                                Click="BtnJitterPlus_Click"/>
                    </StackPanel>
                    <Button x:Name="BtnJitterReset"
                            Style="{StaticResource WmcButtonStyle}"
                            Content="Reset to 250 ms"
                            HorizontalAlignment="Left"
                            MinWidth="240"
                            Margin="10,16,0,0"
                            Click="BtnJitterReset_Click"/>

                    <!-- =================================================
                         Advanced diagnostics — these surface env-var
                         toggles that previously had to be set before
                         launch via `set SOFTSLED_X=Y`. The config
                         values are translated into process-scope env
                         vars at session start, so existing call sites
                         keep working unchanged.
                         ================================================= -->
                    <TextBlock Style="{StaticResource WmcSubtitleStyle}"
                               Text="Advanced diagnostic dumps"
                               Foreground="{StaticResource WmcTextBrush}"
                               Margin="0,32,0,4"/>
                    <TextBlock Style="{StaticResource WmcBodyStyle}"
                               Foreground="{StaticResource WmcSubtleTextBrush}"
                               Margin="0,0,0,16"
                               TextWrapping="Wrap"
                               Text="Mirror of the SOFTSLED_* environment variables. Files are written to the folder shown below. Changes take effect on the NEXT session start."/>

                    <CheckBox x:Name="ChkDumpSplashRaw"
                              Style="{StaticResource WmcCheckBoxStyle}"
                              Content="Dump splash wire bytes + events (SOFTSLED_SPLASH_RAW_DUMP)"
                              Click="OnConfigChanged"/>
                    <CheckBox x:Name="ChkDumpFastpathRaw"
                              Style="{StaticResource WmcCheckBoxStyle}"
                              Content="Dump RDP fastpath payloads (SOFTSLED_FASTPATH_RAW_DUMP)"
                              Click="OnConfigChanged"/>
                    <CheckBox x:Name="ChkDumpAudio"
                              Style="{StaticResource WmcCheckBoxStyle}"
                              Content="Dump fastpath audio PCM (SOFTSLED_AUDIO_DUMP)"
                              Click="OnConfigChanged"/>
                    <CheckBox x:Name="ChkDumpRtspWire"
                              Style="{StaticResource WmcCheckBoxStyle}"
                              Content="Dump RTSP control-channel wire (SOFTSLED_RTSP_WIRE_DUMP)"
                              Click="OnConfigChanged"/>

                    <StackPanel Orientation="Horizontal" Margin="10,8,0,0">
                        <TextBlock x:Name="DumpFolderPath"
                                   Style="{StaticResource WmcBodyStyle}"
                                   Foreground="{StaticResource WmcSubtleTextBrush}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="360"
                                   Text="(folder)"/>
                        <Button x:Name="BtnOpenDumpFolder"
                                Content="Open"
                                Margin="12,0,0,0"
                                Padding="14,4"
                                Click="OnOpenDumpFolderClick"/>
                        <Button x:Name="BtnChangeDumpFolder"
                                Content="Change..."
                                Margin="6,0,0,0"
                                Padding="14,4"
                                Click="OnChangeDumpFolderClick"/>
                    </StackPanel>

                    <TextBlock Style="{StaticResource WmcSubtitleStyle}"
                               Text="Advanced behaviour toggles"
                               Foreground="{StaticResource WmcTextBrush}"
                               Margin="0,32,0,4"/>
                    <TextBlock Style="{StaticResource WmcBodyStyle}"
                               Foreground="{StaticResource WmcSubtleTextBrush}"
                               Margin="0,0,0,16"
                               TextWrapping="Wrap"
                               Text="These change runtime behaviour rather than producing files. Use for isolating audio-pipeline issues."/>

                    <CheckBox x:Name="ChkAudioTrace"
                              Style="{StaticResource WmcCheckBoxStyle}"
                              Content="Verbose fastpath audio trace (SOFTSLED_AUDIO_TRACE)"
                              Click="OnConfigChanged"/>
                    <CheckBox x:Name="ChkAudioViaNAudio"
                              Style="{StaticResource WmcCheckBoxStyle}"
                              Content="Route RTSP audio via NAudio (SOFTSLED_AUDIO_VIA_NAUDIO)"
                              Click="OnConfigChanged"/>
                </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ===== About sub-view ======================================= -->
            <Grid x:Name="AboutView"
                  Margin="100,200,100,80"
                  Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Left" Width="640">
                    <TextBlock Style="{StaticResource WmcSubtitleStyle}" Text="SoftSled" Foreground="{StaticResource WmcTextBrush}"/>
                    <TextBlock x:Name="AboutVersionText" Style="{StaticResource WmcBodyStyle}"/>
                    <TextBlock Style="{StaticResource WmcBodyStyle}"
                               Foreground="{StaticResource WmcSubtleTextBrush}"
                               Margin="0,16,0,0"
                               TextWrapping="Wrap"
                               Text="A clean-room Windows Media Center Extender client. See the project README for credits and the protocol notes."/>
                </StackPanel>
            </Grid>

            <!-- ===== Unpair confirm overlay =============================== -->
            <Grid x:Name="ConfirmOverlay"
                  Visibility="Collapsed"
                  Background="#A0000000">
                <Border HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#E0202020"
                        BorderBrush="{StaticResource WmcSelectionBorderBrush}"
                        BorderThickness="2"
                        CornerRadius="8"
                        Padding="40,30"
                        MinWidth="520">
                    <StackPanel>
                        <TextBlock Style="{StaticResource WmcSubtitleStyle}"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   Text="Unpair extender?"/>
                        <TextBlock Style="{StaticResource WmcBodyStyle}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   Margin="0,10,0,20"
                                   Text="The stored host credentials will be removed. You will need to pair again before connecting."/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button x:Name="ConfirmYes"
                                    Style="{StaticResource WmcButtonStyle}"
                                    Content="Unpair"
                                    Click="ConfirmYes_Click"/>
                            <Button x:Name="ConfirmNo"
                                    Style="{StaticResource WmcButtonStyle}"
                                    Content="Cancel"
                                    IsCancel="True"
                                    Click="ConfirmNo_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===== Remote "learn" overlay ============================== -->
            <Grid x:Name="RemoteLearnOverlay"
                  Visibility="Collapsed"
                  Background="#A0000000">
                <Border HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#E0202020"
                        BorderBrush="{StaticResource WmcSelectionBorderBrush}"
                        BorderThickness="2"
                        CornerRadius="8"
                        Padding="40,30"
                        MinWidth="560">
                    <StackPanel>
                        <TextBlock Style="{StaticResource WmcSubtitleStyle}"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   Text="Press a remote button"/>
                        <TextBlock x:Name="RemoteLearnPrompt"
                                   Style="{StaticResource WmcBodyStyle}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   Margin="0,12,0,20"
                                   TextWrapping="Wrap"
                                   Text="Press the button you want to use…"/>
                        <Button x:Name="RemoteLearnCancel"
                                Style="{StaticResource WmcButtonStyle}"
                                Content="Cancel"
                                HorizontalAlignment="Center"
                                IsCancel="True"
                                Click="RemoteLearnCancel_Click"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===== Resolution picker overlay ============================ -->
            <Grid x:Name="ResolutionOverlay"
                  Visibility="Collapsed"
                  Background="#A0000000">
                <Border HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#E0202020"
                        BorderBrush="{StaticResource WmcSelectionBorderBrush}"
                        BorderThickness="2"
                        CornerRadius="8"
                        Padding="40,30"
                        MinWidth="560"
                        MaxHeight="560">
                    <StackPanel>
                        <TextBlock Style="{StaticResource WmcSubtitleStyle}"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   Text="Choose resolution"
                                   Margin="0,0,0,10"/>
                        <ListBox x:Name="ResolutionList"
                                 Style="{StaticResource WmcListBoxStyle}"
                                 ItemContainerStyle="{StaticResource WmcListItemStyle}"
                                 MaxHeight="380"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 KeyDown="ResolutionList_KeyDown"
                                 MouseLeftButtonUp="ResolutionList_MouseLeftButtonUp"/>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Margin="0,10,0,0">
                            <Button x:Name="ResolutionCancel"
                                    Style="{StaticResource WmcButtonStyle}"
                                    Content="Cancel"
                                    IsCancel="True"
                                    Click="ResolutionCancel_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Hint strip -->
            <TextBlock Text="Use the remote arrow keys to navigate. Press Backspace or Escape to go back."
                       Style="{StaticResource WmcBodyStyle}"
                       Foreground="{StaticResource WmcSubtleTextBrush}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Bottom"
                       Margin="0,0,40,30"/>
        </Grid>
    </Viewbox>
</UserControl>
