<UserControl x:Class="SoftSledWPF.Components.Shell.ConfigPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="Transparent"
             d:DesignHeight="720" d:DesignWidth="1280">
    <Viewbox Stretch="Uniform">
        <Grid Width="1280" Height="720">

            <!-- Title strip — shared across all sub-views, content set
                 from code-behind when sub-view changes. -->
            <TextBlock x:Name="HeaderText"
                       Style="{StaticResource WmcTitleStyle}"
                       Text="settings"
                       Margin="100,60,0,0"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"/>

            <TextBlock x:Name="BreadcrumbText"
                       Style="{StaticResource WmcSubtitleStyle}"
                       Foreground="{StaticResource WmcSubtleTextBrush}"
                       Margin="100,135,0,0"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"/>

            <!-- ===== Root menu ============================================ -->
            <Grid x:Name="RootView"
                  Margin="100,200,100,80"
                  Visibility="Visible">
                <ListBox x:Name="RootMenu"
                         Style="{StaticResource WmcListBoxStyle}"
                         ItemContainerStyle="{StaticResource WmcListItemStyle}"
                         Width="520"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Top"
                         KeyDown="RootMenu_KeyDown"
                         MouseLeftButtonUp="RootMenu_MouseLeftButtonUp">
                    <ListBoxItem x:Name="ItemGeneral"   Content="General"  IsSelected="True"/>
                    <ListBoxItem x:Name="ItemPairing"   Content="Pairing"/>
                    <ListBoxItem x:Name="ItemVideo"     Content="Video"/>
                    <ListBoxItem x:Name="ItemUi"        Content="UI"/>
                    <ListBoxItem x:Name="ItemDebugging" Content="Debugging"/>
                    <ListBoxItem x:Name="ItemAbout"     Content="About"/>
                </ListBox>
            </Grid>

            <!-- ===== General sub-view ===================================== -->
            <Grid x:Name="GeneralView"
                  Margin="100,200,100,80"
                  Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Left" Width="640">
                    
                    <CheckBox x:Name="ChkFullScreen"
                              Style="{StaticResource WmcCheckBoxStyle}"
                              Content="Run full screen"
                              Click="OnConfigChanged"/>
                    <CheckBox x:Name="ChkAutoStart"
                              Style="{StaticResource WmcCheckBoxStyle}"
                              Content="Auto-start the extender session on launch"
                              Click="OnConfigChanged"/>
                    <CheckBox x:Name="ChkCloseOnWmcClose"
                              Style="{StaticResource WmcCheckBoxStyle}"
                              Content="Close SoftSled when Windows Media Center closes"
                              Click="OnConfigChanged"/>
                    <TextBlock Style="{StaticResource WmcBodyStyle}"
                               Foreground="{StaticResource WmcSubtleTextBrush}"
                               Margin="10,16,0,0"
                               Text="Tip: press F11 at any time to toggle full screen without changing this setting."/>
                </StackPanel>
            </Grid>

            <!-- ===== Pairing sub-view ===================================== -->
            <Grid x:Name="PairingView"
                  Margin="100,200,100,80"
                  Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Left" Width="640">
                    <TextBlock x:Name="PairingStatusText"
                               Style="{StaticResource WmcBodyStyle}"
                               Margin="10,0,0,30"/>
                    <Button x:Name="UnpairButton"
                            Style="{StaticResource WmcButtonStyle}"
                            Content="Unpair extender"
                            HorizontalAlignment="Left"
                            MinWidth="240"
                            Click="UnpairButton_Click"/>
                    <TextBlock Style="{StaticResource WmcBodyStyle}"
                               Foreground="{StaticResource WmcSubtleTextBrush}"
                               Margin="10,30,0,0"
                               TextWrapping="Wrap"
                               Text="Unpairing clears the stored host credentials. You will need to run the Add Extender wizard in Windows Media Center again before you can connect."/>
                </StackPanel>
            </Grid>

            <!-- ===== Video sub-view ======================================= -->
            <Grid x:Name="VideoView"
                  Margin="100,200,100,80"
                  Visibility="Collapsed">
                <!-- Content can overflow the ~440px sub-view height
                     once enough toggles are added; wrap in a
                     ScrollViewer so lower controls stay reachable.
                     Focusable=False keeps the WMC-remote tab-stop
                     traversal walking through the child checkboxes,
                     and each focused control auto-scrolls into view
                     via WPF's default BringIntoView behaviour. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly"
                              Focusable="False">
                <StackPanel HorizontalAlignment="Left" Width="640">
                    <CheckBox x:Name="ChkHdContent"
                              Style="{StaticResource WmcCheckBoxStyle}"
                              Content="Enable HD Content"
                              Click="OnConfigChanged"/>
                    <CheckBox x:Name="ChkRemoteRendering"
                              Style="{StaticResource WmcCheckBoxStyle}"
                              Content="Enable Remote Rendering"
                              Click="OnConfigChanged"/>
                    <CheckBox x:Name="Chk2DAnimations"
                              Style="{StaticResource WmcCheckBoxStyle}"
                              Content="Enable 2D animations"
                              Click="OnConfigChanged"/>
                    <CheckBox x:Name="ChkIntenseAnimations"
                              Style="{StaticResource WmcCheckBoxStyle}"
                              Content="Enable Intense animations"
                              Click="OnConfigChanged"/>
                    <CheckBox x:Name="ChkOverscan"
                              Style="{StaticResource WmcCheckBoxStyle}"
                              Content="Enable Overscan Margin"
                              Click="OnConfigChanged"/>

                    <!-- Resolution picker. The button shows the current
                         selection; clicking opens the ResolutionOverlay
                         below for picking a new one. Lives in its own
                         labelled row so it visually groups with the
                         tickboxes without trying to be one. -->
                    <TextBlock Style="{StaticResource WmcSubtitleStyle}"
                               Text="Resolution"
                               Foreground="{StaticResource WmcTextBrush}"
                               Margin="10,30,0,8"/>
                    <Button x:Name="BtnResolution"
                            Style="{StaticResource WmcButtonStyle}"
                            HorizontalAlignment="Left"
                            MinWidth="320"
                            Margin="10,0,0,0"
                            Content="—"
                            Click="BtnResolution_Click"/>
                </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ===== UI sub-view ========================================== -->
            <Grid x:Name="UiView"
                  Margin="100,200,100,80"
                  Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Left" Width="640">
                    <CheckBox x:Name="ChkUiSounds"
                              Style="{StaticResource WmcCheckBoxStyle}"
                              Content="Enable UI Sounds"
                              Click="OnConfigChanged"/>
                    <CheckBox x:Name="ChkPopups"
                              Style="{StaticResource WmcCheckBoxStyle}"
                              Content="Enable Pop-ups"
                              Click="OnConfigChanged"/>
                    <CheckBox x:Name="ChkToolbar"
                              Style="{StaticResource WmcCheckBoxStyle}"
                              Content="Enable Toolbar"
                              Click="OnConfigChanged"/>
                    <CheckBox x:Name="ChkMouseInput"
                              Style="{StaticResource WmcCheckBoxStyle}"
                              Content="Enable mouse input"
                              Click="OnConfigChanged"/>
                </StackPanel>
            </Grid>

            <!-- ===== Debugging sub-view =================================== -->
            <Grid x:Name="DebuggingView"
                  Margin="100,200,100,80"
                  Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Left" Width="640">
                    <CheckBox x:Name="ChkLogger"
                              Style="{StaticResource WmcCheckBoxStyle}"
                              Content="Show on-screen log overlay"
                              Click="OnConfigChanged"/>
                    <TextBlock Style="{StaticResource WmcBodyStyle}"
                               Foreground="{StaticResource WmcSubtleTextBrush}"
                               Margin="10,16,0,24"
                               TextWrapping="Wrap"
                               Text="The log overlay appears on the right edge of the session view. You can also toggle it during a session with Ctrl+L."/>

                    <CheckBox x:Name="ChkLogDevCaps"
                              Style="{StaticResource WmcCheckBoxStyle}"
                              Content="Include DevCaps VirtualChannel logs"
                              Click="OnConfigChanged"/>
                    <CheckBox x:Name="ChkLogMcxSess"
                              Style="{StaticResource WmcCheckBoxStyle}"
                              Content="Include McxSess VirtualChannel logs"
                              Click="OnConfigChanged"/>
                    <CheckBox x:Name="ChkLogAvCtrl"
                              Style="{StaticResource WmcCheckBoxStyle}"
                              Content="Include AvCtrl VirtualChannel logs"
                              Click="OnConfigChanged"/>
                    <CheckBox x:Name="ChkLogRdpFastpath"
                              Style="{StaticResource WmcCheckBoxStyle}"
                              Content="Include RDP Fastpath logs"
                              Click="OnConfigChanged"/>
                </StackPanel>
            </Grid>

            <!-- ===== About sub-view ======================================= -->
            <Grid x:Name="AboutView"
                  Margin="100,200,100,80"
                  Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Left" Width="640">
                    <TextBlock Style="{StaticResource WmcSubtitleStyle}" Text="SoftSled" Foreground="{StaticResource WmcTextBrush}"/>
                    <TextBlock x:Name="AboutVersionText" Style="{StaticResource WmcBodyStyle}"/>
                    <TextBlock Style="{StaticResource WmcBodyStyle}"
                               Foreground="{StaticResource WmcSubtleTextBrush}"
                               Margin="0,16,0,0"
                               TextWrapping="Wrap"
                               Text="A clean-room Windows Media Center Extender client. See the project README for credits and the protocol notes."/>
                </StackPanel>
            </Grid>

            <!-- ===== Unpair confirm overlay =============================== -->
            <Grid x:Name="ConfirmOverlay"
                  Visibility="Collapsed"
                  Background="#A0000000">
                <Border HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#E0202020"
                        BorderBrush="{StaticResource WmcSelectionBorderBrush}"
                        BorderThickness="2"
                        CornerRadius="8"
                        Padding="40,30"
                        MinWidth="520">
                    <StackPanel>
                        <TextBlock Style="{StaticResource WmcSubtitleStyle}"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   Text="Unpair extender?"/>
                        <TextBlock Style="{StaticResource WmcBodyStyle}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   Margin="0,10,0,20"
                                   Text="The stored host credentials will be removed. You will need to pair again before connecting."/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button x:Name="ConfirmYes"
                                    Style="{StaticResource WmcButtonStyle}"
                                    Content="Unpair"
                                    Click="ConfirmYes_Click"/>
                            <Button x:Name="ConfirmNo"
                                    Style="{StaticResource WmcButtonStyle}"
                                    Content="Cancel"
                                    IsCancel="True"
                                    Click="ConfirmNo_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===== Resolution picker overlay ============================ -->
            <Grid x:Name="ResolutionOverlay"
                  Visibility="Collapsed"
                  Background="#A0000000">
                <Border HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#E0202020"
                        BorderBrush="{StaticResource WmcSelectionBorderBrush}"
                        BorderThickness="2"
                        CornerRadius="8"
                        Padding="40,30"
                        MinWidth="560"
                        MaxHeight="560">
                    <StackPanel>
                        <TextBlock Style="{StaticResource WmcSubtitleStyle}"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   Text="Choose resolution"
                                   Margin="0,0,0,10"/>
                        <ListBox x:Name="ResolutionList"
                                 Style="{StaticResource WmcListBoxStyle}"
                                 ItemContainerStyle="{StaticResource WmcListItemStyle}"
                                 MaxHeight="380"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 KeyDown="ResolutionList_KeyDown"
                                 MouseLeftButtonUp="ResolutionList_MouseLeftButtonUp"/>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Margin="0,10,0,0">
                            <Button x:Name="ResolutionCancel"
                                    Style="{StaticResource WmcButtonStyle}"
                                    Content="Cancel"
                                    IsCancel="True"
                                    Click="ResolutionCancel_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Hint strip -->
            <TextBlock Text="Use the remote arrow keys to navigate. Press Backspace or Escape to go back."
                       Style="{StaticResource WmcBodyStyle}"
                       Foreground="{StaticResource WmcSubtleTextBrush}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Bottom"
                       Margin="0,0,40,30"/>
        </Grid>
    </Viewbox>
</UserControl>
