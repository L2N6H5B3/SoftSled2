<UserControl x:Class="SoftSledWPF.Components.Shell.ExtenderSessionControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:splash="clr-namespace:SoftSled.Components.Splash"
             xmlns:ffme="clr-namespace:Unosquare.FFME;assembly=ffme.win"
             mc:Ignorable="d"
             Focusable="True"
             Background="Black"
             d:DesignHeight="720" d:DesignWidth="1280">
    <!-- Hosts the live extender session: FFME video, RDP framebuffer, and
         the MS-RRSP2 splash overlay. The shell pushes this control into the
         page Frame; Start() spins up the FreeRdpClient and channels, Stop()
         tears them back down so the user can return to the landing page
         without process exit. -->
    <Grid>
        <Canvas x:Name="MediaCanvas" ClipToBounds="True">
            <ffme:MediaElement x:Name="Media"
                       Canvas.Left="0" Canvas.Top="0"
                       Background="Black"
                       LoadedBehavior="Play"
                       UnloadedBehavior="Manual"
                       Visibility="Collapsed"/>
            <ffme:MediaElement x:Name="MediaAudio"
                       Canvas.Left="-100" Canvas.Top="-100"
                       Width="1" Height="1"
                       LoadedBehavior="Play"
                       UnloadedBehavior="Manual"
                       Visibility="Visible"/>
        </Canvas>

        <Image x:Name="rdpDisplay"
               Stretch="Uniform"
               RenderOptions.BitmapScalingMode="HighQuality"
               Visibility="Hidden"/>

        <splash:SplashRenderHost x:Name="splashHost"
                                 Visibility="Collapsed"
                                 IsHitTestVisible="False"/>

        <!-- Connecting status overlay. Shown from Start() until either
             FreeRDP transitions to Active or the splash overlay first
             paints something (whichever fires first). Sits in the same
             grid cell as the other layers and is z-ordered below the
             debug log so a future log toggle remains visible. -->
        <Grid x:Name="ConnectingOverlay"
              Background="Black"
              Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="softsled"
                           Foreground="#80FFFFFF"
                           FontFamily="Segoe UI Light"
                           FontSize="64"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,30"/>
                <TextBlock x:Name="ConnectingStatusText"
                           Text="Waiting to connect to Windows Media Center"
                           Foreground="White"
                           FontFamily="Segoe UI"
                           FontSize="22"
                           HorizontalAlignment="Center"/>
                <!-- Indeterminate spinner: a stroke arc rotated by a
                     storyboard. Light-touch — no DispatcherTimer, no
                     custom control, just one ellipse + one RotateTransform. -->
                <Grid Width="56" Height="56" Margin="0,40,0,0" HorizontalAlignment="Center">
                    <Ellipse Stroke="#30FFFFFF" StrokeThickness="4"/>
                    <Ellipse x:Name="SpinnerArc"
                             Stroke="#FF1FB6F0"
                             StrokeThickness="4"
                             StrokeDashArray="3 6"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <RotateTransform x:Name="SpinnerRotate" Angle="0"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                </Grid>
            </StackPanel>
        </Grid>

        <!-- Debug logger overlay. Hidden by default; ShellWindow toggles
             visibility via a Ctrl+L shortcut when something needs eyeballing. -->
        <TextBox x:Name="loggerTextBox"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Stretch"
                 Width="300"
                 Margin="5"
                 TextWrapping="Wrap"
                 Background="#A0000000"
                 Foreground="#E0E0E0"
                 BorderBrush="#60FFFFFF"
                 IsReadOnly="True"
                 VerticalScrollBarVisibility="Auto"
                 Visibility="Collapsed"/>
    </Grid>
</UserControl>
