<UserControl x:Class="SoftSledWPF.Components.Shell.ExtenderSessionControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:splash="clr-namespace:SoftSled.Components.Splash"
             mc:Ignorable="d"
             Focusable="True"
             Background="Black"
             d:DesignHeight="720" d:DesignWidth="1280">
    <!-- Hosts the live extender session: FFME video, RDP framebuffer, and
         the MS-RRSP2 splash overlay. The shell pushes this control into the
         page Frame; Start() spins up the FreeRdpClient and channels, Stop()
         tears them back down so the user can return to the landing page
         without process exit. -->
    <Grid>
        <!-- Splash HostWindow background fill (MS-RRSP2 §2.2.4.23.2).
             Painted at the BOTTOM of the visual stack so the video plane
             (MediaCanvas) can composite over it and the splash scene
             graph (splashHost) can paint over both — matches the Xbox /
             WMC hardware model of "video plane between background and
             UI". SplashController pushes HostWindow_SetBackgroundColor
             updates here via the BackgroundColorSink callback wired in
             ExtenderSessionControl.xaml.cs; default Transparent so a
             session that never sets a background colour leaves whatever
             rdpDisplay shows (GDI mode) or just the parent's grey
             showing through (RUI mode before HostWindow_SetBackgroundColor
             arrives). -->
        <Rectangle x:Name="splashBackgroundFill"
                   Fill="Transparent"/>

        <Canvas x:Name="MediaCanvas" ClipToBounds="True">
            <!-- Video plane: an Image whose Source is the D3DImage from the
                 GPU presenter (libav decode → D3D9Ex surface). The RDP layer
                 (rdpDisplay) composites over this with per-pixel alpha, same
                 as it did over the old FFME element. -->
            <!-- Stretch defaults to Uniform (preserve source aspect) — the
                 correct neutral state before WMC sends an explicit zoom mode
                 over the fastpath channel. OnZoomModeChanged overrides it per
                 WMC's selection (Normal→Uniform, StretchSides→Fill,
                 StretchTopBottom→UniformToFill). The old "Fill" default
                 distorted fullscreen video whenever WMC never sent a zoom
                 message (the common case for default playback). -->
            <Image x:Name="VideoImage"
                   Canvas.Left="0" Canvas.Top="0"
                   Stretch="None"
                   Visibility="Collapsed"/>
        </Canvas>

        <Image x:Name="rdpDisplay"
               Stretch="Uniform"
               RenderOptions.BitmapScalingMode="HighQuality"
               Visibility="Hidden"/>

        <splash:SplashRenderHost x:Name="splashHost"
                                 Visibility="Collapsed"
                                 IsHitTestVisible="False"/>

        <!-- Mouse input capture layer (task #170 follow-up). Always-present
             transparent Border that sits above BOTH rdpDisplay and splashHost
             so mouse moves/clicks reach RdpDisplay_* handlers regardless of
             which layer is currently the visible UI. Without this, mouse
             events vanish whenever rdpDisplay is hidden (e.g. during a
             splash-only session) because Hidden elements don't hit-test.
             Background="Transparent" is required for the Border to receive
             hits — null background = no hit-test. -->
        <Border x:Name="MouseInputLayer"
                Background="Transparent"/>

        <!-- Connecting status overlay. Shown from Start() until either
             FreeRDP transitions to Active or the splash overlay first
             paints something (whichever fires first). Sits in the same
             grid cell as the other layers and is z-ordered below the
             debug log so a future log toggle remains visible. -->
        <Grid x:Name="ConnectingOverlay"
              Background="Black"
              Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="softsled"
                           Foreground="#80FFFFFF"
                           FontFamily="Segoe UI Light"
                           FontSize="64"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,30"/>
                <TextBlock x:Name="ConnectingStatusText"
                           Text="Waiting to connect to Windows Media Center"
                           Foreground="White"
                           FontFamily="Segoe UI"
                           FontSize="22"
                           HorizontalAlignment="Center"/>
                <!-- Indeterminate spinner: a stroke arc rotated by a
                     storyboard. Light-touch — no DispatcherTimer, no
                     custom control, just one ellipse + one RotateTransform. -->
                <Grid Width="56" Height="56" Margin="0,40,0,0" HorizontalAlignment="Center">
                    <Ellipse Stroke="#30FFFFFF" StrokeThickness="4"/>
                    <Ellipse x:Name="SpinnerArc"
                             Stroke="#FF1FB6F0"
                             StrokeThickness="4"
                             StrokeDashArray="3 6"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <RotateTransform x:Name="SpinnerRotate" Angle="0"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                </Grid>
            </StackPanel>
        </Grid>

        <!-- Debug logger overlay. Hidden by default; ShellWindow toggles
             visibility via a Ctrl+L shortcut when something needs eyeballing. -->
        <TextBox x:Name="loggerTextBox"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Stretch"
                 Width="300"
                 Margin="5"
                 TextWrapping="Wrap"
                 Background="#A0000000"
                 Foreground="#E0E0E0"
                 BorderBrush="#60FFFFFF"
                 IsReadOnly="True"
                 VerticalScrollBarVisibility="Auto" Visibility="Collapsed"/>
    </Grid>
</UserControl>
