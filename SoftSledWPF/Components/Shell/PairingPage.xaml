<UserControl x:Class="SoftSledWPF.Components.Shell.PairingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="Transparent"
             FocusManager.FocusedElement="{Binding ElementName=CancelButton}"
             d:DesignHeight="720" d:DesignWidth="1280">
    <Viewbox Stretch="Uniform">
        <Grid Width="1280" Height="720">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="800">
                <TextBlock Text="pair extender" Style="{StaticResource WmcTitleStyle}" HorizontalAlignment="Center"/>

                <TextBlock Style="{StaticResource WmcBodyStyle}"
                           Text="In Windows Media Center on your PC, open the Add Extender wizard and enter the setup key shown below."
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Margin="0,0,0,30"/>

                <Border BorderBrush="{StaticResource WmcSelectionBorderBrush}"
                        BorderThickness="2"
                        CornerRadius="10"
                        Padding="40,20"
                        HorizontalAlignment="Center"
                        Background="#40000000">
                    <TextBlock x:Name="PinText"
                               Text="----,----"
                               FontFamily="Consolas"
                               FontSize="80"
                               Foreground="White"
                               HorizontalAlignment="Center"/>
                </Border>

                <TextBlock x:Name="StatusText"
                           Style="{StaticResource WmcBodyStyle}"
                           HorizontalAlignment="Center"
                           Margin="0,30,0,0"
                           Text="Waiting for Windows Media Center..."/>

                <Button x:Name="CancelButton"
                        Style="{StaticResource WmcButtonStyle}"
                        Content="Cancel"
                        HorizontalAlignment="Center"
                        Margin="0,40,0,0"
                        Click="CancelButton_Click"/>
            </StackPanel>
        </Grid>
    </Viewbox>
</UserControl>
