    <None Include="native\x64\zd.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- OpenH264 runtime decoder, loaded by freerdp3.dll at session start
         when the host negotiates RDPGFX with H.264. Required for the
         AVC444/H.264 path; without it FreeRDP silently falls back to
         RemoteFX/progressive. -->
    <None Include="native\x64\openh264-7.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- x86 build of the shim and its deps. Copied alongside x64; App.OnStartup
         calls SetDllDirectory pointing at whichever matches the host bitness.
         Glob form keeps the csproj quiet about a folder that may not yet exist
         (the x86 native build is opt-in until someone runs the parallel CMake). -->
    <None Include="native\x86\**\*.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>native\x86\%(RecursiveDir)%(FileName)%(Extension)</Link>
    </None>
